DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/resume_sender"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Set to the canonical app origin in production; Google redirect URI is {NEXTAUTH_URL}/api/auth/callback/google.
NEXTAUTH_URL="http://localhost:3000"
# Google OAuth web client: authorize http://localhost:3000 locally and the production origin in Google Cloud.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Private AWS S3 or S3-compatible storage
STORAGE_PROVIDER="aws"
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="resume-sender-private"
STORAGE_ACCESS_KEY_ID="replace-with-a-restricted-storage-access-key"
STORAGE_SECRET_ACCESS_KEY="replace-with-the-storage-secret"
STORAGE_FORCE_PATH_STYLE="false"
STORAGE_SIGNED_URL_TTL_SECONDS="120"

# The server enforces an absolute maximum of 5 MiB.
RESUME_MAX_FILE_SIZE_BYTES="5242880"
